{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/sobre", "destination": "/index.html" },
    { "source": "/servicos", "destination": "/index.html" },
    { "source": "/valores", "destination": "/index.html" },
    { "source": "/profissionais", "destination": "/index.html" },
    { "source": "/contato", "destination": "/index.html" }
  ]
}
